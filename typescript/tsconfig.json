{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@support/*": ["src/support/*"],
      "@pages/*": ["src/pages/*"],
      "@clients/*": ["src/clients/*"],
      "@models/*": ["src/models/*"],
      "@flows/*": ["src/flows/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "playwright.config.ts",
    "playwright.destructive.config.ts",
    "global.setup.ts",
    "global.teardown.ts"
  ]
}

{
  "title": "Toolshop product",
  "description": "JSON Schema draft 2020-12. Derived from live responses of GET https://api.practicesoftwaretesting.com/products on 2026-09-17. The draft version is declared by the validator in each module, not inline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "price",
    "is_location_offer",
    "is_rental",
    "in_stock",
    "category",
    "brand"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/ulid" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "price": { "type": "number", "exclusiveMinimum": 0 },
    "is_location_offer": { "type": "boolean" },
    "is_rental": { "type": "boolean" },
    "in_stock": { "type": "boolean" },
    "is_eco_friendly": { "type": "boolean" },
    "co2_rating": { "type": ["string", "null"], "pattern": "^[A-G]$" },
    "product_image": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "file_name"],
      "properties": {
        "id": { "$ref": "#/$defs/ulid" },
        "by_name": { "type": ["string", "null"] },
        "by_url": { "type": ["string", "null"] },
        "source_name": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"] },
        "file_name": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug"],
      "properties": {
        "id": { "$ref": "#/$defs/ulid" },
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/ulid" },
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": ["string", "null"] }
      }
    },
    "specs": {
      "description": "Present only on GET /products/{id}. The list endpoint omits it entirely, which is why it is optional rather than required — one schema then covers both representations.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "product_id", "spec_name", "spec_value"],
        "properties": {
          "id": { "$ref": "#/$defs/ulid" },
          "product_id": { "$ref": "#/$defs/ulid" },
          "spec_name": { "type": "string", "minLength": 1 },
          "spec_value": { "type": ["string", "number", "null"] },
          "spec_unit": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "description": "Crockford base32 ULID, 26 characters. Excludes I, L, O and U.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}

# Copy to .env and fill in. NEVER commit .env.
# Every AF_* variable overrides the matching value from shared/environments/<env>.json.

# ---------------------------------------------------------------------------
# Environment selection
# ---------------------------------------------------------------------------
# Which shared/environments/<name>.json to load. local | dev | staging
AF_ENV=local

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------
# Leave both empty to use the values in shared/environments/<AF_ENV>.json.
# The default target is the Toolshop demo app (practicesoftwaretesting.com),
# a public sandbox. Set these only to point at a different environment.
AF_UI_BASEURL=
AF_API_BASEURL=

# ---------------------------------------------------------------------------
# Credentials  (test environments only — never production)
# ---------------------------------------------------------------------------
# The Toolshop demo publishes its own sandbox accounts. They are throwaway
# credentials for a public playground with no real data behind them, which is
# why they can appear here. In a real project this file holds placeholders
# only, and the values come from the CI secret store.
#
#   customer role: customer@practicesoftwaretesting.com / welcome01
#   admin role:    admin@practicesoftwaretesting.com    / welcome01
#
# Copy the ones you need into .env. The suite fails fast at startup if they are
# missing rather than falling back to a default.
AF_AUTH_USERNAME=
AF_AUTH_PASSWORD=

# Admin account, used only by tests that need elevated rights.
AF_AUTH_ADMIN_USERNAME=
AF_AUTH_ADMIN_PASSWORD=

# OAuth / client-credentials flow — unused by the Toolshop demo, which uses a
# plain email+password login. Fill these in when targeting a real service.
AF_AUTH_CLIENTID=
AF_AUTH_CLIENTSECRET=YOUR_CLIENT_SECRET_HERE
AF_AUTH_TOKENURL=

# ---------------------------------------------------------------------------
# Test data
# ---------------------------------------------------------------------------
# Faker seed. Set to reproduce a specific run's generated data.
AF_DATA_SEED=
# Overrides the generated run id. Leave empty for a fresh one per run.
AF_RUN_ID=

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
# Worker count. Leave empty to let the runner decide.
AF_WORKERS=
# true | false. Always true in CI.
AF_HEADLESS=true

# ---------------------------------------------------------------------------
# MCP servers (see docs/mcp/README.md)
# These are NOT read by the test suite. They belong in your shell or user
# environment so MCP servers inherit them at launch. Listed here only so the
# required names are discoverable.
# ---------------------------------------------------------------------------
# Fine-grained, read-only, single-repo, with an expiry.
# GITHUB_PERSONAL_ACCESS_TOKEN=YOUR_READONLY_PAT_HERE

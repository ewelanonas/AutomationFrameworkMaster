# Copy to .env and fill in. NEVER commit .env.
# Every AF_* variable overrides the matching value from shared/environments/<env>.json.

# ---------------------------------------------------------------------------
# Environment selection
# ---------------------------------------------------------------------------
# Which shared/environments/<name>.json to load. local | ci | dev | staging
AF_ENV=local
#
# `ci` points at the Toolshop application running as containers on the CI
# runner itself (loopback: UI on 4200, API on 8091), not at the public sandbox.
# CI sets AF_ENV=ci for you; you do not need it here.
#
# A local run does NOT need Docker. Leaving AF_ENV=local keeps the public
# sandbox as the target, which is how every documented local command works.
#
# If you do want the same containers locally, bring them up by hand from the
# worktree root and set AF_ENV=ci in your shell for that session:
#
#   $env:TOOLSHOP_DB_PASSWORD='changeme-local'
#   docker compose -f .github/docker/docker-compose.ci.yml up -d --wait
#   $env:AF_ENV='ci'
#   ... run a suite ...
#   docker compose -f .github/docker/docker-compose.ci.yml down -v
#
# TOOLSHOP_DB_PASSWORD is the throwaway password for a container-local MariaDB
# that publishes no port. It is not a secret, and it is not read by the suites.
# See docs/decisions/0007-self-hosted-demo-target.md.

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------
# Leave both empty to use the values in shared/environments/<AF_ENV>.json.
# The default target is the Toolshop demo app (practicesoftwaretesting.com),
# a public sandbox. Set these only to point at a different environment.
AF_UI_BASEURL=
AF_API_BASEURL=

# ---------------------------------------------------------------------------
# Credentials  (test environments only — never production)
# ---------------------------------------------------------------------------
# The Toolshop demo publishes its own sandbox accounts. They are throwaway
# credentials for a public playground with no real data behind them, which is
# why they can appear here. In a real project this file holds placeholders
# only, and the values come from the CI secret store.
#
#   customer role: customer@practicesoftwaretesting.com / welcome01
#   admin role:    admin@practicesoftwaretesting.com    / welcome01
#
# Copy the ones you need into .env. The suite fails fast at startup if they are
# missing rather than falling back to a default.
AF_AUTH_USERNAME=
AF_AUTH_PASSWORD=

# Admin account, used only by tests that need elevated rights.
AF_AUTH_ADMIN_USERNAME=
AF_AUTH_ADMIN_PASSWORD=

# OAuth / client-credentials flow — unused by the Toolshop demo, which uses a
# plain email+password login. Fill these in when targeting a real service.
AF_AUTH_CLIENTID=
AF_AUTH_CLIENTSECRET=YOUR_CLIENT_SECRET_HERE
AF_AUTH_TOKENURL=

# ---------------------------------------------------------------------------
# Test data
# ---------------------------------------------------------------------------
# Faker seed. Set to reproduce a specific run's generated data.
AF_DATA_SEED=
# Overrides the generated run id. Leave empty for a fresh one per run.
AF_RUN_ID=
#
# Note: AF_RUN_ID and AF_DATA_SEED are read from the PROCESS environment, not
# from this file ($env:AF_RUN_ID='...' in PowerShell). RunContext and TestValues
# resolve run identity before any config loading, so they never see .env.

# ---------------------------------------------------------------------------
# Timeouts  (milliseconds, 1000-600000; a bad value fails the run)
# ---------------------------------------------------------------------------
# Leave empty to use shared/environments/<AF_ENV>.json. CI no longer sets any
# AF_TIMEOUTS_* variable: it resolves them from shared/environments/ci.json,
# which keeps the same 10s element budget local runs use. Set one here only to
# override the descriptor for your own run.
# Element state: the budget for one locator action or web-first assertion.
AF_TIMEOUTS_ELEMENTMS=
# Navigation: the budget for a page load to reach its ready state.
AF_TIMEOUTS_NAVIGATIONMS=
# API: the budget for one HTTP request to the service under test.
AF_TIMEOUTS_APIMS=
# Workflow: the budget for an async business process to complete.
AF_TIMEOUTS_WORKFLOWMS=

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
# Worker count. Leave empty to let the runner decide.
AF_WORKERS=
# true | false. Always true in CI.
AF_HEADLESS=true
# chromium | firefox | webkit. Leave empty for chromium. All three config
# loaders read this; it was missing here while being documented per module.
AF_BROWSER=

# ---------------------------------------------------------------------------
# MCP servers (see docs/mcp/README.md)
# These are NOT read by the test suite. They belong in your shell or user
# environment so MCP servers inherit them at launch. Listed here only so the
# required names are discoverable.
# ---------------------------------------------------------------------------
# Fine-grained, read-only, single-repo, with an expiry.
# GITHUB_PERSONAL_ACCESS_TOKEN=YOUR_READONLY_PAT_HERE
